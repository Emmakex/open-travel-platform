# Public application identity
# The upstream/demo identity is Open Travel Platform. Independent public/commercial deployments
# should set their own primary site name/tagline and may truthfully state "Based on Open Travel Platform".
# See TRADEMARKS.md / TRADEMARKS.es.md. Do not use Kairoseth Travel as an independent deployment brand.
NEXT_PUBLIC_SITE_NAME=Open Travel Platform
NEXT_PUBLIC_SITE_TAGLINE=Build travel products without vendor lock-in.

# Canonical public URL used to build server-generated email links and same-origin browser protections.
KTRAVEL_PUBLIC_URL=https://travel.kairoseth.com

# KTRAVEL_* names are retained legacy technical configuration identifiers. Their presence does not
# identify a deployment as Kairoseth Travel and does not grant branding/endorsement rights.
# Any future namespace migration must follow the documented upgrade/deprecation lifecycle.

# Deployment readiness profile: demo | live.
# live makes /api/health/ready fail when demo capabilities are active, the public URL is not HTTPS,
# required MongoDB is unavailable, or an enabled outbound REST adapter lacks the worker token.
KTRAVEL_DEPLOYMENT_PROFILE=demo

# Optional comma-separated exact browser origins accepted by cookie-authenticated Route Handler mutations.
# KTRAVEL_PUBLIC_URL and the request's own origin are already accepted. Do not use wildcards.
KTRAVEL_ALLOWED_BROWSER_ORIGINS=

# Enable only when the hosting/reverse-proxy edge removes user-supplied forwarding headers and writes trusted
# CF-Connecting-IP, X-Real-IP or X-Forwarded-For values. When false, auth rate limiting still applies per subject.
KTRAVEL_TRUST_PROXY_IP_HEADERS=false

# Public presentation mode: demo | api
# Keep demo while the public Kairoseth Travel deployment contains fictional content/noindex metadata.
NEXT_PUBLIC_DATA_MODE=demo

# Server-side catalogue repository: demo | api | mongodb
TRAVEL_DATA_MODE=demo

# Generic HTTP catalogue adapter. This mode is read-only and browser-visible; do not put secrets here.
NEXT_PUBLIC_TRAVEL_API_URL=

# MongoDB travel catalogue.
TRAVEL_MONGODB_URI=
TRAVEL_MONGODB_DB=ktravel
TRAVEL_MONGODB_DESTINATIONS_COLLECTION=destinations
TRAVEL_MONGODB_TRIPS_COLLECTION=trips

# Identity repository: demo | mongodb | disabled
IDENTITY_MODE=disabled
IDENTITY_MONGODB_URI=
IDENTITY_MONGODB_DB=ktravel
IDENTITY_MONGODB_USERS_COLLECTION=users
IDENTITY_SESSION_TTL_SECONDS=2592000
IDENTITY_SESSION_COOKIE=kts
DEMO_IDENTITY_ENABLED=false

# Staff authentication: demo | mongodb | disabled
STAFF_AUTH_MODE=disabled
STAFF_AUTH_MONGODB_URI=
STAFF_AUTH_MONGODB_DB=ktravel
STAFF_AUTH_MONGODB_USERS_COLLECTION=staff_users
STAFF_AUTH_SESSION_TTL_SECONDS=28800
STAFF_AUTH_SESSION_COOKIE=kt_staff_session

# Booking repository: demo | mongodb | rest | disabled
BOOKING_MODE=disabled
DEMO_BOOKING_ENABLED=false
BOOKING_MONGODB_URI=
BOOKING_MONGODB_DB=ktravel
BOOKING_MONGODB_RESERVATIONS_COLLECTION=reservations
BOOKING_MONGODB_AVAILABILITY_COLLECTION=availability
BOOKING_MONGODB_IDEMPOTENCY_COLLECTION=booking_idempotency
BOOKING_REST_BASE_URL=
BOOKING_REST_TOKEN=
BOOKING_REST_TIMEOUT_MS=5000
BOOKING_REST_MAX_RESPONSE_BYTES=1048576

# Operations repository: demo | mongodb | disabled
OPERATIONS_MODE=disabled
DEMO_OPERATIONS_ENABLED=false
OPERATIONS_MONGODB_URI=
OPERATIONS_MONGODB_DB=ktravel
OPERATIONS_MONGODB_RESERVATIONS_COLLECTION=reservations
OPERATIONS_MONGODB_AUDIT_COLLECTION=operations_audit
OPERATIONS_MONGODB_TASKS_COLLECTION=operations_tasks

# Local provider-neutral payment/refund ledger: mongodb | disabled
PAYMENT_LEDGER_MODE=disabled
PAYMENT_MONGODB_URI=
PAYMENT_MONGODB_DB=ktravel
PAYMENT_MONGODB_MOVEMENTS_COLLECTION=payment_movements
PAYMENT_MONGODB_IDEMPOTENCY_COLLECTION=payment_idempotency

# Traveller data protection / encryption.
# Use a versioned keyring for live Traveller Data. Values are base64-encoded 32-byte AES keys.
TRAVELLER_DATA_ACTIVE_KEY_ID=
TRAVELLER_DATA_KEYRING=

# Supplier fulfilment adapter: disabled | rest
SUPPLIER_FULFILMENT_ADAPTER_MODE=disabled
SUPPLIER_FULFILMENT_REST_BASE_URL=
SUPPLIER_FULFILMENT_REST_TOKEN=
SUPPLIER_FULFILMENT_REST_TIMEOUT_MS=5000
SUPPLIER_FULFILMENT_REST_MAX_RESPONSE_BYTES=1048576

# CRM synchronization adapter: disabled | rest
CRM_SYNC_MODE=disabled
CRM_SYNC_REST_BASE_URL=
CRM_SYNC_REST_TOKEN=
CRM_SYNC_REST_TIMEOUT_MS=5000
CRM_SYNC_REST_MAX_RESPONSE_BYTES=1048576

# ERP/accounting adapter: disabled | rest
ERP_ACCOUNTING_MODE=disabled
ERP_ACCOUNTING_REST_BASE_URL=
ERP_ACCOUNTING_REST_TOKEN=
ERP_ACCOUNTING_REST_TIMEOUT_MS=5000
ERP_ACCOUNTING_REST_MAX_RESPONSE_BYTES=1048576

# Operational failure transport: disabled | rest
FAILURE_TRANSPORT_MODE=disabled
FAILURE_TRANSPORT_REST_URL=
FAILURE_TRANSPORT_REST_TOKEN=
FAILURE_TRANSPORT_TIMEOUT_MS=5000
FAILURE_TRANSPORT_MAX_RESPONSE_BYTES=65536

# Generic signed integration webhooks.
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_TIMEOUT_MS=5000
INTEGRATION_WEBHOOK_MAX_ATTEMPTS=5
INTEGRATION_WEBHOOK_RETRY_BASE_MS=1000

# Outbound integration worker auth. Required only when integration delivery endpoints/workers are enabled.
INTEGRATION_WORKER_TOKEN=

# SMTP / email delivery. Leave disabled in demo unless intentionally testing delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# Stripe checkout (server-side secrets only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Redsys checkout (server-side secrets only).
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test
REDSYS_SUCCESS_URL=
REDSYS_ERROR_URL=
REDSYS_NOTIFICATION_URL=

# Privacy / retention execution.
PRIVACY_RETENTION_ENABLED=false
PRIVACY_RETENTION_DAYS=0
PRIVACY_RETENTION_BATCH_SIZE=100

# External monitoring integration. Monitoring must remain non-authoritative.
EXTERNAL_MONITORING_MODE=disabled
EXTERNAL_MONITORING_URL=
EXTERNAL_MONITORING_TOKEN=
EXTERNAL_MONITORING_TIMEOUT_MS=5000
