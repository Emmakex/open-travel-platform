# Public application identity
NEXT_PUBLIC_SITE_NAME=Open Travel Platform
NEXT_PUBLIC_SITE_TAGLINE=Build travel products without vendor lock-in.

# Canonical public URL used to build server-generated email links.
KTRAVEL_PUBLIC_URL=https://travel.kairoseth.com

# Public presentation mode: demo | api
# Keep demo while the public Kairoseth Travel deployment contains fictional content/noindex metadata.
NEXT_PUBLIC_DATA_MODE=demo

# Server-side catalogue repository: demo | api | mongodb
# When omitted, the application falls back to NEXT_PUBLIC_DATA_MODE.
TRAVEL_DATA_MODE=demo

# Optional browser-safe API base URL for the catalogue adapter.
# Never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_TRAVEL_API_URL=

# Server-only MongoDB configuration.
# Prefer MONGODB_URI. MONGO_URL/DATABASE_URL are accepted only when they contain a mongodb:// or mongodb+srv:// URI.
MONGODB_URI=
MONGODB_DB_NAME=ktravel

# Customer identity mode: demo | mongodb | disabled
# mongodb enables persistent customer registration/sign-in.
IDENTITY_MODE=demo

# Staff identity mode: demo | mongodb | disabled
# If omitted, legacy demo staff remains available only when DEMO_IDENTITY_ENABLED=true.
# Set mongodb to use travel_staff_users/travel_staff_sessions.
STAFF_AUTH_MODE=demo

# One-time bootstrap admin for the first persistent staff account.
# Configure these only for the initial bootstrap, sign in successfully, then remove the password variable.
KTRAVEL_BOOTSTRAP_ADMIN_EMAIL=
KTRAVEL_BOOTSTRAP_ADMIN_PASSWORD=
KTRAVEL_BOOTSTRAP_ADMIN_NAME=Kairoseth Admin

# SMTP transactional email delivery. The built-in transport uses implicit TLS (normally port 465).
# Keep credentials server-only; never expose them as NEXT_PUBLIC_* variables.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kairoseth Travel

# Optional comma/semicolon-separated operations recipients for new reservation and status-change alerts.
# When omitted, internal reservation notifications fall back to SMTP_FROM_EMAIL.
KTRAVEL_OPERATIONS_EMAILS=

# Production safety switch for intentional demo identities.
DEMO_IDENTITY_ENABLED=false

# Booking mode: demo | mongodb | disabled
BOOKING_MODE=demo

# Production safety switch for fictional cookie-backed customer reservation writes.
DEMO_BOOKING_ENABLED=false

# Staff operations mode: demo | mongodb | disabled
OPERATIONS_MODE=demo

# Production safety switch for fictional operator/admin reservation status writes.
DEMO_OPERATIONS_ENABLED=false

# Payment ledger persistence: mongodb | disabled
# When omitted it follows BOOKING_MODE.
PAYMENT_LEDGER_MODE=mongodb

# One server-only master key used to encrypt payment-provider credentials stored from Admin.
# Generate once and keep it stable for this deployment, for example: openssl rand -base64 32
# Never commit the generated value. Rotating/removing it without re-encrypting provider settings makes stored secrets unreadable.
PAYMENT_SECRETS_KEY=

# Dedicated server-only key for encrypted post-purchase traveller identity/document fields.
# Generate once and keep it stable, for example: openssl rand -base64 32
# Never expose it through NEXT_PUBLIC_* and never rotate/remove it without a controlled re-encryption migration.
TRAVELLER_DATA_KEY=

# Dedicated server-only key for outbound integration/webhook signing secrets stored from Admin.
# Generate once and keep it stable, for example: openssl rand -base64 32
# Secrets are encrypted with AES-256-GCM before persistence. Do not rotate/remove this key without re-encryption.
INTEGRATION_SECRETS_KEY=

# Server-only Bearer token used by a deployment scheduler/worker to POST the outbound delivery processor.
# Use at least 32 high-entropy characters. Never expose this value in NEXT_PUBLIC_* or browser code.
INTEGRATION_WORKER_SECRET=

# Distributed minimum interval between authenticated worker runs, enforced through MongoDB across app instances.
# The application clamps this value to 10–3600 seconds; default is 30.
INTEGRATION_WORKER_MIN_INTERVAL_SECONDS=30

# Retention for succeeded integration deliveries/events/attempts. Dead-letter records are never auto-pruned.
# The application clamps this value to 30–730 days; default is 180.
INTEGRATION_HISTORY_RETENTION_DAYS=180
