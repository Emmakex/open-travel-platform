{
  "name": "open-travel-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Modern open-source travel platform starter for agencies, tour operators and booking products.",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:safety": "node scripts/public-safety-check.mjs",
    "check:release": "node scripts/release-check.mjs",
    "verify": "npm run check:safety && npm run check:release && npm run typecheck && npm run build",
    "check": "npm run verify"
  },
  "dependencies": {
    "mongodb": "7.5.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3"
  }
}
