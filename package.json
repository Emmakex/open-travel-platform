{
  "name": "open-travel-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Modern open-source travel platform starter for agencies, tour operators and booking products.",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:safety": "node scripts/public-safety-check.mjs",
    "check:ux": "node scripts/ux-content-check.mjs",
    "check:release": "node scripts/release-check.mjs",
    "check:amendments": "node scripts/reservation-amendment-check.mjs",
    "check:accommodation": "node scripts/accommodation-foundation-check.mjs",
    "check:package-addons": "node scripts/trip-package-addon-check.mjs",
    "check:operations": "node scripts/reservation-operations-check.mjs",
    "check:tasks": "node scripts/operations-task-check.mjs",
    "check:fulfilment": "node scripts/supplier-fulfilment-check.mjs",
    "check:operations-queue": "node scripts/operations-queue-check.mjs",
    "verify": "npm run check:safety && npm run check:ux && npm run check:release && npm run check:amendments && npm run check:accommodation && npm run check:package-addons && npm run check:operations && npm run check:tasks && npm run check:fulfilment && npm run check:operations-queue && npm run typecheck && npm run build",
    "check": "npm run verify"
  },
  "dependencies": {
    "mongodb": "7.5.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3"
  }
}
